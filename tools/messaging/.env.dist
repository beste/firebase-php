# Copy this file to .env. Existing shell variables take precedence.

# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# Firebase project ID, not display name. Match the PHP test credentials.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=


# Firebase Console > Project settings > Cloud Messaging > Web Push certificates.
# Use the public VAPID key for this Firebase project.
FIREBASE_VAPID_KEY=
