    }
    /**
     * @param class-string      $testClassName
     * @param ?non-empty-string $testMethodName
     *
     * @return non-empty-string
     */
    private function testAsString(string $testClassName, ?string $testMethodName = null): string
    {
        return sprintf('%s %s%s%s', $testMethodName !== null ? 'method' : 'class', $testClassName, $testMethodName !== null ? '::' : '', $testMethodName !== null ? $testMethodName : '');
    }
}
