     * @return non-empty-list<non-empty-string>
     */
    public function available(): array
    {
        $result = [Version::series()];
        foreach (new DirectoryIterator($this->path() . 'schema') as $file) {
            if ($file->isDot()) {
                continue;
            }
            $version = $file->getBasename('.xsd');
            assert($version !== '');
            $result[] = $version;
        }
        rsort($result);
        return $result;
    }
