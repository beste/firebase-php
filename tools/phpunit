            $result['class'] .= sprintf('       <tr><td><a href="%s">%s</a></td><td class="text-right">%.1f%%</td><td class="text-right">%d</td><td class="text-right">%d</td></tr>' . "\n", str_replace($baseLink, '', $classes[$className]->link), $className, $class->coverage, $class->ccn, $class->crap);
