    private const string CLASS_HEADER = <<<'EOT'

        <h2>%s</h2>
        <ul>

EOT;
    private const string CLASS_FOOTER = <<<'EOT'
        </ul>
EOT;
    private const string PAGE_FOOTER = <<<'EOT'

    </body>
