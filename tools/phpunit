                $commonPath .= $paths[0][0];
                if ($paths[0][0] !== DIRECTORY_SEPARATOR) {
                    $commonPath .= DIRECTORY_SEPARATOR;
                }
                for ($i = 0; $i < $max; $i++) {
                    array_shift($paths[$i]);
                }
            }
        }
        $original = $coveredFiles;
        $max = count($original);
        for ($i = 0; $i < $max; $i++) {
