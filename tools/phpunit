    {
        $classScope = !$reflector instanceof ReflectionFunction;
        $typeName = $type->getName();
        assert($typeName !== '');
        if ($classScope && $typeName === 'self') {
            return ObjectType::fromName($reflector->getDeclaringClass()->getName(), $type->allowsNull());
        }
        if ($classScope && $typeName === 'static') {
            return new StaticType(TypeName::fromReflection($reflector->getDeclaringClass()), $type->allowsNull());
