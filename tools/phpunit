                $types[] = $namedType;
                continue;
            }
            $types[] = $this->mapIntersectionType($_type, $reflector);
        }
        if ($objectType && $genericObjectType) {
            $types = array_filter($types, static function (Type $type): bool {
                if ($type instanceof ObjectType) {
                    return \false;
