    private array $testSuiteTests = [0];
    /**
     * @var array<int, int>
     */
    private array $testSuiteAssertions = [0];
    /**
     * @var array<int, int>
     */
    private array $testSuiteErrors = [0];
    /**
     * @var array<int, int>
     */
    private array $testSuiteFailures = [0];
    /**
     * @var array<int, int>
     */
    private array $testSuiteSkipped = [0];
    /**
     * @var array<int, float>
