            $name = $parameter->getName();
            if (!$parameter->hasType()) {
                $parameters[] = new Parameter($name, new UnknownType());
                continue;
            }
            $type = $parameter->getType();
            if ($type instanceof ReflectionNamedType) {
                $parameters[] = new Parameter($name, $this->mapNamedType($type, $reflector));
                continue;
            }
            if ($type instanceof ReflectionUnionType) {
                $parameters[] = new Parameter($name, $this->mapUnionType($type, $reflector));
                continue;
            }
            if ($type instanceof ReflectionIntersectionType) {
                $parameters[] = new Parameter($name, $this->mapIntersectionType($type, $reflector));
            }
        }
        return $parameters;
    }
