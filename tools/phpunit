        if ($configuration->hasExcludeGroups()) {
            $buffer .= 'The --exclude-group (CLI) and <groups> (XML) options cannot be combined with --list-suites, --exclude-group and <groups> are ignored' . PHP_EOL;
        }
        if ($buffer !== '') {
