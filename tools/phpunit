    const INPUT_OUTPUT = 'input_output';
    /**
     * echo, print.
     */
    const STANDARD_OUTPUT = 'standard_output';
    /**
     * code for sure has side-effects, we don't have enough information to classify it.
     */
    const UNKNOWN_CLASS = 'unknown_class';
