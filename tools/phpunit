    /**
     * @param array<class-string, TestResultCollection> $tests
     */
    public function render(array $tests): string
    {
        $buffer = self::PAGE_HEADER;
        foreach ($tests as $_tests) {
            $buffer .= sprintf(self::CLASS_HEADER, htmlspecialchars($_tests->asArray()[0]->test()->testDox()->prettifiedClassName(), ENT_QUOTES | ENT_SUBSTITUTE));
            foreach ($this->reduce($_tests) as $prettifiedMethodName => $outcome) {
                $buffer .= sprintf("            <li class=\"%s\">%s</li>\n", $outcome, htmlspecialchars($prettifiedMethodName, ENT_QUOTES | ENT_SUBSTITUTE));
