      type: "scatter",
      xs: {
        "complexity": "complexity_x",
      },
    },
    grid: {
      focus: {
        show: true,
        y: true,
      },
      x: {
        show: true,
      },
      y: {
        show: true,
      },
    },
    legend: {
      show: false,
    },
