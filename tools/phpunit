            $prev = $current;
            for ($j = 0; $j < $cTo; $j++) {
                if ($from[$i] === $to[$j]) {
                    $current[$j + 1] = $prev[$j] + 1;
                } else if ($current[$j] > $prev[$j + 1]) {
                    $current[$j + 1] = $current[$j];
                } else {
                    $current[$j + 1] = $prev[$j + 1];
                }
            }
        }
